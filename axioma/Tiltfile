version_settings(check_updates=False)
update_settings(max_parallel_updates=6)

PROJECT_NAME = 'axioma'

docker_compose('api/docker-compose.yml', project_name=PROJECT_NAME, wait=True)
dc_resource(
    'postgres',
    project_name=PROJECT_NAME,
    labels=['infrastructure'],
    links=['postgresql://postgres:password@localhost:5432/axioma'],
)

local_resource(
    'api',
    cmd='pnpm install --frozen-lockfile && pnpm db:push',
    serve_cmd='pnpm dev',
    dir='api',
    serve_dir='api',
    resource_deps=['postgres'],
    readiness_probe=probe(http_get=http_get_action(port=3000, path='/health')),
    links=['http://localhost:3000', 'http://localhost:3000/health'],
    labels=['backend'],
    allow_parallel=True,
)

local_resource(
    'portal',
    cmd='pnpm install --frozen-lockfile',
    serve_cmd='pnpm dev',
    dir='portal',
    serve_dir='portal',
    resource_deps=['api'],
    readiness_probe=probe(tcp_socket=tcp_socket_action(port=3001)),
    links=['http://localhost:3001'],
    labels=['frontend'],
    allow_parallel=True,
)

local_resource(
    'dashboard',
    cmd='pnpm install --frozen-lockfile',
    serve_cmd='pnpm dev',
    dir='dashboard',
    serve_dir='dashboard',
    resource_deps=['api'],
    readiness_probe=probe(tcp_socket=tcp_socket_action(port=3002)),
    links=['http://localhost:3002'],
    labels=['frontend'],
    allow_parallel=True,
)

local_resource(
    'web',
    cmd='pnpm install --frozen-lockfile',
    serve_cmd='pnpm exec vite dev --port 3003',
    dir='web',
    serve_dir='web',
    readiness_probe=probe(tcp_socket=tcp_socket_action(port=3003)),
    links=['http://localhost:3003'],
    labels=['frontend'],
    allow_parallel=True,
)

local_resource(
    'agent',
    cmd='uv sync --all-extras',
    serve_cmd='uv run python -m axel.server',
    dir='agent',
    serve_dir='agent',
    deps=['agent/axel', 'agent/pyproject.toml', 'agent/uv.lock'],
    ignore=['agent/**/__pycache__', 'agent/.venv', 'agent/.pytest_cache', 'agent/.ruff_cache'],
    resource_deps=['api'],
    readiness_probe=probe(http_get=http_get_action(port=8090, path='/health')),
    labels=['backend'],
    allow_parallel=True,
)

local_resource(
    'cli',
    cmd='go build -o bin/axel-cli.exe ./cmd/axel-cli',
    dir='cli',
    deps=['cli/cmd', 'cli/internal', 'cli/go.mod', 'cli/go.sum'],
    labels=['device'],
    allow_parallel=True,
)
