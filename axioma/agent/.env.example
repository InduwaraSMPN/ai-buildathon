AXIOMA_API_BASE=
AXIOMA_LLM_KEY=
AXIOMA_MODEL=
AXIOMA_REASONING_EFFORT=

# Shared secret proving this worker is one the operator deployed. The gateway
# port is reachable by every enrolled laptop and this channel carries ticket
# text, reporter identity and tool execution, so a worker id alone is not an
# identity: the gateway refuses every agent connection when this is unset. Must
# be the same value as AXIOMA_AGENT_TOKEN on the API.
AXIOMA_AGENT_TOKEN=

# Gateway address, and the CA that signs its certificate. The CA is appended to
# the system pool rather than replacing it, and verification is never disabled —
# so a self-signed gateway certificate (the local stack serves the one in
# api/certs) needs this set or the handshake fails with
# CERTIFICATE_VERIFY_FAILED and the worker never connects.
AXIOMA_API_GRPC_HOST=
AXIOMA_API_GRPC_CA_FILE=
AXIOMA_API_GRPC_SERVER_NAME=

# Set per replica when the config directory is a shared volume, so replicas do
# not all claim one worker id and collapse into a single entry in the gateway's
# registry. Falls back to a file under the config directory.
AXIOMA_WORKER_ID=
