{
	"name": "axioma-api",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Axioma API — oRPC surface for the frontends, gRPC gateways for the agent and devices, and the only component that writes.",
	"main": "src/index.ts",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsdown",
		"start": "node dist/index.mjs",
		"check": "biome check --write .",
		"check-types": "tsc --noEmit",
		"test": "tsx --test src/**/*.test.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:start": "docker compose up -d --wait",
		"db:stop": "docker compose stop",
		"db:down": "docker compose down",
		"contracts:publish": "node scripts/publish-contracts.mjs",
		"seed": "node scripts/seed-scenarios.mjs",
		"seed:reset": "node scripts/seed-scenarios.mjs --reset",
		"seed:device": "pwsh -File scripts/seed-device-fault.ps1"
	},
	"dependencies": {
		"@grpc/grpc-js": "^1.14.4",
		"@grpc/proto-loader": "^0.8.1",
		"@hono/node-server": "^2.0.12",
		"@kubernetes/client-node": "^2.0.0",
		"@orpc/contract": "^1.15.0",
		"@orpc/openapi": "^1.14.12",
		"@orpc/server": "^1.14.12",
		"@orpc/zod": "^1.14.12",
		"@t3-oss/env-core": "^0.13.11",
		"better-auth": "1.7.1",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.12.32",
		"pg": "^8.22.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@types/node": "^26.2.0",
		"@types/pg": "^8.20.0",
		"drizzle-kit": "^0.31.10",
		"tsdown": "^0.22.14",
		"tsx": "^4.23.1",
		"typescript": "^6.0.3"
	},
	"packageManager": "pnpm@11.24.0"
}
