{
	"name": "@axioma/server",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "tsx watch src/index.ts",
		"start": "node dist/index.mjs"
	},
	"dependencies": {
		"@axioma/api": "workspace:*",
		"@axioma/auth": "workspace:*",
		"@axioma/db": "workspace:*",
		"@axioma/env": "workspace:*",
		"@hono/node-server": "^2.0.12",
		"@orpc/openapi": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/zod": "catalog:",
		"better-auth": "catalog:",
		"dotenv": "catalog:",
		"hono": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@axioma/config": "workspace:*",
		"@types/node": "catalog:",
		"tsdown": "^0.22.14",
		"tsx": "^4.23.1",
		"typescript": "catalog:"
	}
}
