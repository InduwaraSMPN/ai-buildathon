{
    "mcpServers": {
        "chrome-devtools": {
            "type": "stdio",
            "command": "cmd",
            "args": [
                "/c",
                "npx",
                "-y",
                "chrome-devtools-mcp@latest"
            ],
            "env": {},
            "disabled": false,
            "alwaysAllow": []
        },
        "context7": {
            "type": "streamable-http",
            "url": "https://mcp.context7.com/mcp"
        }
    }
}
